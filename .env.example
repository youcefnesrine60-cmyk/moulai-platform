# MoulAI™ Platform environment template
# Copy this file to .env and replace every placeholder with local values.
# NEVER commit .env or real credentials.

# ========================
# Application
# ========================
APP_ENV=development
DEBUG=false
APP_NAME=MoulAI
APP_VERSION=1.0.0
APP_URL=http://localhost:8000

# ========================
# Database
# ========================
# primary keeps DATABASE_URL as the ORM target (the production default).
# Local development can explicitly select development without changing that URL.
# development requires APP_ENV=development or test, TEST_DATABASE_URL pointing
# to neondb_test,
# and all verified development/protected endpoint and branch settings below.
# This switch does not retarget Alembic or production billing operations.
# Keep the production Render service on primary.
DATABASE_TARGET=primary
DATABASE_URL=postgresql+asyncpg://moulai_user:change-me@localhost:5432/moulai
DATABASE_SYNC_URL=postgresql://moulai_user:change-me@localhost:5432/moulai
TEST_DATABASE_URL=
TEST_DATABASE_SYNC_URL=
TEST_DATABASE_ENDPOINT_ID=
PROTECTED_DATABASE_ENDPOINT_ID=
TEST_DATABASE_BRANCH_ID=
TEST_DATABASE_PROJECT_ID=
PROTECTED_DATABASE_BRANCH_ID=

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# Telegram
# ========================
BOT_TOKEN=your-telegram-bot-token
WEBHOOK_URL=http://localhost:8000/webhook
WEBHOOK_PATH=/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Manual subscription billing (no external payment gateway is enabled).
MANUAL_CCP_ENABLED=true
MANUAL_BARIDIMOB_ENABLED=true
MANUAL_TRANSFER_BENEFICIARY=
MANUAL_CCP_ACCOUNT=
MANUAL_CCP_KEY=
MANUAL_BARIDIMOB_RIP=

# ========================
# AI
# ========================
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ========================
# Security
# ========================
# Generate a unique random value of at least 32 characters.
SECRET_KEY=replace-with-a-random-secret-key-of-at-least-32-characters
# Local K8 values only. Use reviewed HTTPS endpoints outside local diagnostics.
# Authentication client moulai-local-test is separate from the API audience.
OIDC_ISSUER=http://localhost:8080/realms/moulai
OIDC_AUDIENCE=moulai-api
OIDC_JWKS_URL=http://localhost:8080/realms/moulai/protocol/openid-connect/certs
# Disabled by default. Diagnostics require APP_ENV=development,
# DATABASE_TARGET=development, DEBUG=false and DB_ECHO=false as well.
# The HTTP exception NEVER applies to business owner/admin authentication.
OIDC_DIAGNOSTICS_ENABLED=false
OIDC_ALLOW_LOCAL_HTTP=false

# ========================
# CORS
# ========================
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:3000

# ========================
# Database performance
# ========================
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# ========================
# Redis performance
# ========================
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=5

# ========================
# Rate limiting
# ========================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ========================
# Logging
# ========================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log

# ========================
# Subscription
# ========================
DEFAULT_SUBSCRIPTION_PLAN=basic
TRIAL_PERIOD_DAYS=14
MAX_RESTAURANTS_PER_OWNER=10
TENANT_ISOLATION_LEVEL=strict

# ========================
# Disposable local PostgreSQL tests (launcher supplies process values)
# Independent of DATABASE_URL / TEST_DATABASE_URL; leave blank for the app.
# ========================
LOCAL_POSTGRES_TEST_URL=
LOCAL_POSTGRES_TEST_INSTANCE_ID=
LOCAL_POSTGRES_TEST_SERVER_PORT=
