# MoulAI™ Platform environment template
# Copy this file to .env and replace every placeholder with local values.
# NEVER commit .env or real credentials.

# ========================
# Application
# ========================
APP_ENV=development
DEBUG=false
APP_NAME=MoulAI
APP_VERSION=1.0.0
APP_URL=http://localhost:8000

# ========================
# Database
# ========================
DATABASE_URL=postgresql+asyncpg://moulai_user:change-me@localhost:5432/moulai
DATABASE_SYNC_URL=postgresql://moulai_user:change-me@localhost:5432/moulai

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# Telegram
# ========================
BOT_TOKEN=your-telegram-bot-token
WEBHOOK_URL=http://localhost:8000/webhook
WEBHOOK_PATH=/webhook

# ========================
# AI
# ========================
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ========================
# Security
# ========================
# Generate a unique random value of at least 32 characters.
SECRET_KEY=replace-with-a-random-secret-key-of-at-least-32-characters
# Fill these with the actual values from the MoulAI Keycloak realm.
# Keep empty until the realm, API client, and token audience mapper exist.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# ========================
# CORS
# ========================
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:3000

# ========================
# Database performance
# ========================
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# ========================
# Redis performance
# ========================
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=5

# ========================
# Rate limiting
# ========================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ========================
# Logging
# ========================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log

# ========================
# Subscription
# ========================
DEFAULT_SUBSCRIPTION_PLAN=basic
TRIAL_PERIOD_DAYS=14
MAX_RESTAURANTS_PER_OWNER=10
TENANT_ISOLATION_LEVEL=strict
