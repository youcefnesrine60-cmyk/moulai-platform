# ==============================================
# 🌍 DZ-EATERY PLATFORM - ENVIRONMENT VARIABLES
# ==============================================
# 🚀 Python 3.14+ | Last Updated: 2026-07-19
# ==============================================

# ==============================================
# 🐘 DATABASE - PostgreSQL (Neon.tech)
# ==============================================
# 📌 PostgreSQL connection string with asyncpg support
# Format: postgresql+asyncpg://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode

# 📌 Alternative format (for sync operations)
DATABASE_SYNC_URL=postgresql://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================
# 🔴 CACHE & SESSION - Redis (Upstash)
# ==============================================
# 📌 Redis connection for caching, rate limiting, and sessions
# Format: rediss://default:password@host:port
REDIS_URL=rediss://default:your_password@your-upstash-url.upstash.io:6379

# ==============================================
# 🤖 TELEGRAM BOT
# ==============================================
# 📌 Bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# 📌 Webhook URL (for production)
WEBHOOK_URL=https://your-domain.com/webhook

# 📌 Webhook path (where Telegram sends updates)
WEBHOOK_PATH=/webhook/telegram

# ==============================================
# 🔐 SECURITY & AUTHENTICATION
# ==============================================
# 📌 Secret key for JWT tokens and session encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here

# 📌 API keys for external services
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================
# 🌐 ENVIRONMENT & DEPLOYMENT
# ==============================================
# 📌 Environment: development, staging, production
ENVIRONMENT=development

# 📌 Debug mode (True/False) - Always False in production
DEBUG=True

# 📌 App name and version
APP_NAME=DZ-EATERY
APP_VERSION=1.0.0

# ==============================================
# 🏪 MULTI-TENANT SETTINGS
# ==============================================
# 📌 Default restaurant isolation level
TENANT_ISOLATION_LEVEL=strict

# 📌 Maximum restaurants per owner
MAX_RESTAURANTS_PER_OWNER=10

# ==============================================
# 📊 SUBSCRIPTION & BILLING
# ==============================================
# 📌 Subscription plans: basic, pro, enterprise
DEFAULT_SUBSCRIPTION_PLAN=basic

# 📌 Trial period in days
TRIAL_PERIOD_DAYS=14

# ==============================================
# ⚡ PERFORMANCE & OPTIMIZATION
# ==============================================
# 📌 Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=True

# 📌 Redis connection pool settings
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=5

# 📌 Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==============================================
# 📝 LOGGING & MONITORING
# ==============================================
# 📌 Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 📌 Log format: json or text
LOG_FORMAT=json

# 📌 Log file path
LOG_FILE_PATH=logs/app.log

# ==============================================
# 🌐 CORS & SECURITY
# ==============================================
# 📌 Allowed origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ==============================================
# 📧 EMAIL (Optional - for future features)
# ==============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=noreply@your-domain.com

# ==============================================
# 🧪 TESTING (Optional)
# ==============================================
# TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/test_db
# TEST_REDIS_URL=redis://localhost:6379/1