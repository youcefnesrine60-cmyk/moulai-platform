{
  "name": "moulai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "CC-BY-NC-ND-4.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:review": "vite --mode review --host 127.0.0.1",
    "typecheck": "tsc -b && tsc --ignoreConfig --allowJs --checkJs --noEmit --skipLibCheck --target es2022 --lib es2022,dom public/theme-init.js",
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:guards": "node scripts/check-review-guards.mjs",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run test:guards && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-direction": "1.2.0",
    "@radix-ui/react-select": "2.4.1",
    "@tanstack/react-query": "5.104.5",
    "i18next": "26.5.4",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.1.0",
    "react-router": "8.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
